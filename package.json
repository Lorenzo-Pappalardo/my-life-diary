{
	"name": "my-life-logbook",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint --ext .js,.ts,.svelte .",
		"lint:fix": "prettier --write . && eslint --ext .js,.ts,.svelte --fix .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm build",
		"prisma:db:push": "prisma db push",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:generate": "prisma generate",
		"import:generate": "tsc --project ./src/import/markdown/tsconfig.json && node ./src/import/markdown/main.js",
		"export:generate": "tsc --project ./src/routes/export/tsconfig.json"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"formsnap": "^2.0.1",
		"pg": "^8.23.0",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.34.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^25.9.5",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"prisma": "^7.10.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	}
}
